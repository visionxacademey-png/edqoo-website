# NeonDB PostgreSQL Connection String
# Get your free serverless connection string from https://console.neon.tech
# Example: postgresql://edqoo_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/edqoo?sslmode=require
DATABASE_URL=YOUR_NEON_DATABASE_URL_HERE

# Security / JWT Secret Key
JWT_SECRET=edqoo_ultra_secure_jwt_token_signing_secret_key_2026

# Server Port
PORT=5000

# Google Gemini API Key (Server-side ONLY - Never expose to client!)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Chatbot Contact Fallbacks
CHATBOT_CONTACT_NUMBER="+91 90744 50935"
CHATBOT_CONTACT_WHATSAPP="9074450935"

# Frontend API URL (leave empty for automatic dev proxy via Vite)
VITE_API_URL=

