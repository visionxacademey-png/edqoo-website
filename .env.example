# NeonDB PostgreSQL Connection String
# Get your free serverless connection string from https://console.neon.tech
# Example: postgresql://edqoo_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/edqoo?sslmode=require
DATABASE_URL=YOUR_NEON_DATABASE_URL_HERE

# Security / JWT Secret Key
JWT_SECRET=edqoo_ultra_secure_jwt_token_signing_secret_key_2026

# Server Port (configured to 5001 to avoid conflict with other localhost services on 5000)
PORT=5001

# Google Gemini API Key (Server-side ONLY - Never expose to client!)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Chatbot Contact Fallbacks
CHATBOT_CONTACT_NUMBER="+91 90744 50935"
CHATBOT_CONTACT_WHATSAPP="9074450935"

# Resend Email Configuration (Server-side ONLY - Never expose to client!)
# Get your API key from https://resend.com
RESEND_API_KEY=your_resend_api_key
# Resend verified sender email (e.g. notifications@edqoo.com or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=Edqoo <onboarding@resend.dev>
# Administrator / Internal inbox that receives all form submissions
CONTACT_RECEIVER_EMAIL=admin@edqoo.com

# Frontend API URL (default: /api, proxied by Vite dev server to backend)
VITE_API_URL=/api


